{
  "apis": [
    {
      "id": "mojang",
      "name": "Mojang",
      "manifest_url": "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"
    },
    {
      "id": "fabric",
      "name": "Fabric",
      "loader_versions_url": "https://meta.fabricmc.net/v2/versions/loader/{minecraft_version}",
      "installer_versions_url": "https://meta.fabricmc.net/v2/versions/installer",
      "installer_download_url": "https://maven.fabricmc.net/net/fabricmc/fabric-installer/{version}/fabric-installer-{version}.jar"
    },
    {
      "id": "forge",
      "name": "Minecraft Forge",
      "forge_promotions_url": "https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json",
      "forge_installer_download_url": "https://maven.minecraftforge.net/net/minecraftforge/forge/{minecraft_version}-{forge_version}/forge-{minecraft_version}-{forge_version}-installer.jar"
    },
    {
      "id": "neoforge",
      "name": "NeoForge",
      "neoforge_versions_url": "https://maven.neoforged.net/releases/net/neoforged/neoforge/maven-metadata.xml",
      "neoforge_installer_download_url": "https://maven.neoforged.net/releases/net/neoforged/neoforge/{version}/neoforge-{version}-installer.jar"
    },
    {
      "id": "paper",
      "name": "PaperMC",
      "paper_project_url": "https://fill.papermc.io/v3/projects/paper",
      "paper_version_builds_url": "https://fill.papermc.io/v3/projects/paper/versions/{minecraft_version}/builds"
    }
  ]
}
